+    /// Record an object emitted inline, even when its contents equal an earlier object.
+    /// AMF3 readers reserve one reference-table slot for every inline object.
+    pub(crate) fn record_inline(&self, val: T) -> usize {
+        let mut cache = self.cache.borrow_mut();
+        let index = cache.len();
+        cache.push(val);
+        index
+    }
+
     /// Retrieve the item at the given index from the cache
