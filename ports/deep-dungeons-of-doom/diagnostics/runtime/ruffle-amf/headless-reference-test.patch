diff --git a/tests/tests/shared_object_reference_probe.rs b/tests/tests/shared_object_reference_probe.rs
new file mode 100644
index 0000000..392a833
--- /dev/null
+++ b/tests/tests/shared_object_reference_probe.rs
@@ -0,0 +1,33 @@
+use ruffle_core::backend::storage::{MemoryStorageBackend, StorageBackend};
+use ruffle_test_framework::environment::Environment;
+use ruffle_test_framework::options::TestOptions;
+use ruffle_test_framework::runner::TestStatus;
+use ruffle_test_framework::test::Test;
+use ruffle_test_framework::vfs::{PhysicalFS, VfsPath};
+use std::thread::sleep;
+
+pub fn run(environment: &impl Environment) -> Result<(), libtest_mimic::Failed> {
+    let mut storage: Box<dyn StorageBackend> = Box::<MemoryStorageBackend>::default();
+    for phase in 1..=2 {
+        let test = Test::from_options(
+            TestOptions {
+                num_frames: Some(1),
+                output_path: format!("output{phase}.txt").into(),
+                ..Default::default()
+            },
+            VfsPath::new(PhysicalFS::new("tests/swfs/avm2/original_amf_reference_probe/")),
+            "shared_object_reference_probe".to_string(),
+        )?;
+        let mut runner = test.create_test_runner(environment)?;
+        runner.player().lock().unwrap().swap_storage(&mut storage);
+        loop {
+            match runner.tick()? {
+                TestStatus::Continue => {}
+                TestStatus::Sleep(duration) => sleep(duration),
+                TestStatus::Finished => break,
+            }
+        }
+        runner.player().lock().unwrap().swap_storage(&mut storage);
+    }
+    Ok(())
+}
