+    /// Diagnostic wall times: instance lock, other locks, and mixing work.
+    /// Enabled by the caller; the ordinary path performs no clock reads.
+    pub fn mix_with_timing<'a, T>(&self, output_buffer: &mut [T]) -> [std::time::Duration; 3]
