+        self.mix_inner(output_buffer, Some(&mut phases));
+        phases
+    }
+
+    fn mix_inner<'a, T>(
+        &self,
+        output_buffer: &mut [T],
+        mut timing: Option<&mut [std::time::Duration; 3]>,
+    )
+    where
+        T: 'a
+            + Default
+            + dasp::Sample<Signed = T>
+            + dasp::sample::ToSample<f32>
+            + dasp::sample::FromSample<i16>,
+    {
+        let mut start = timing.as_ref().map(|_| std::time::Instant::now());
         let mut sound_instances = self
             .sound_instances
             .lock()
             .expect("Cannot be called reentrant");
+        if let (Some(started), Some(phases)) = (start, timing.as_mut()) {
+            phases[0] = started.elapsed();
+            start = Some(std::time::Instant::now());
+        }
         let volume = *self.volume.read().expect("Cannot be called reentrant");
         let mut output_memory = self
             .output_memory
             .write()
             .expect("Cannot be called reentrant");
+        if let (Some(started), Some(phases)) = (start, timing.as_mut()) {
+            phases[1] = started.elapsed();
+            start = Some(std::time::Instant::now());
+        }
         AudioMixer::mix_audio::<T>(
             &mut sound_instances,
             volume,
             self.num_output_channels,
             output_buffer,
             &mut output_memory,
-        )
+        );
+        if let (Some(started), Some(phases)) = (start, timing.as_mut()) {
+            phases[2] = started.elapsed();
+        }
     }
 }
 
