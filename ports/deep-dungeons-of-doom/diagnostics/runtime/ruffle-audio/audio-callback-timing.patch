diff --git a/frontend-utils/src/backends/audio/timing.rs b/frontend-utils/src/backends/audio/timing.rs
new file mode 100644
index 0000000..84a0dff
--- /dev/null
+++ b/frontend-utils/src/backends/audio/timing.rs
@@ -0,0 +1,225 @@
+//! Opt-in audio measurements. The callback never logs or waits for the reporter.
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+#[derive(Clone, Copy, Debug, Default)]
+pub(super) struct Report {
+    pub callbacks: u64,
+    pub frames: u64,
+    pub interval_us: u64,
+    // Total callback, instance-lock wait, other-lock wait, and mixing work.
+    pub totals_us: [u64; 4],
+    pub maxima_us: [u64; 4],
+    pub chunk_total_us: u64,
+    pub gap_max_us: u64,
+    pub gap_gt_previous_chunk: u64,
+    pub zero_queue_delay: u64,
+    pub past_queue_delay: u64,
+    pub queue_delay_min_us: Option<u64>,
+}
+
+fn micros(value: Duration) -> u64 {
+    value.as_micros().min(u128::from(u64::MAX)) as u64
+}
+
+impl Report {
+    fn record(
+        &mut self,
+        frames: u64,
+        chunk: Duration,
+        gap: Option<(Duration, Duration)>,
+        queue_delay: Option<Duration>,
+        total: Duration,
+        phases: [Duration; 3],
+    ) {
+        self.callbacks += 1;
+        self.frames += frames;
+        self.chunk_total_us += micros(chunk);
+        for (i, value) in [total, phases[0], phases[1], phases[2]]
+            .into_iter()
+            .enumerate()
+        {
+            let value = micros(value);
+            self.totals_us[i] += value;
+            self.maxima_us[i] = self.maxima_us[i].max(value);
+        }
+        if let Some((gap, previous_chunk)) = gap {
+            self.gap_max_us = self.gap_max_us.max(micros(gap));
+            self.gap_gt_previous_chunk += u64::from(gap > previous_chunk);
+        }
+        if let Some(delay) = queue_delay {
+            let us = micros(delay);
+            self.queue_delay_min_us = Some(self.queue_delay_min_us.map_or(us, |old| old.min(us)));
+            if delay.is_zero() {
+                self.zero_queue_delay += 1;
+            } else {
+                self.past_queue_delay += u64::from(total > delay);
+            }
+        }
+    }
+}
+
+pub(super) struct Reporter {
+    slot: Arc<Mutex<Option<Report>>>,
+    last_poll: Instant,
+}
+
+pub(super) struct Callback {
+    slot: Arc<Mutex<Option<Report>>>,
+    report: Report,
+    since: Instant,
+    previous: Option<(Instant, Duration)>,
+    channels: u16,
+    rate: u32,
+}
+
+pub(super) struct Measurement {
+    start: Instant,
+    frames: u64,
+    chunk: Duration,
+    gap: Option<(Duration, Duration)>,
+    queue_delay: Option<Duration>,
+}
+
+impl Reporter {
+    pub fn new(channels: u16, rate: u32) -> (Self, Callback) {
+        assert!(channels > 0 && rate > 0);
+        let slot = Arc::new(Mutex::new(None));
+        let now = Instant::now();
+        (
+            Self {
+                slot: slot.clone(),
+                last_poll: now,
+            },
+            Callback {
+                slot,
+                report: Report::default(),
+                since: now,
+                previous: None,
+                channels,
+                rate,
+            },
+        )
+    }
+
+    pub fn poll(&mut self) -> Option<Report> {
+        if self.last_poll.elapsed() < Duration::from_secs(1) {
+            return None;
+        }
+        self.last_poll = Instant::now();
+        self.slot.try_lock().ok()?.take()
+    }
+}
+
+impl Callback {
+    pub fn begin(&mut self, samples: usize, queue_delay: Option<Duration>) -> Measurement {
+        let start = Instant::now();
+        let frames = (samples / usize::from(self.channels)) as u64;
+        let chunk = Duration::from_secs_f64(frames as f64 / f64::from(self.rate));
+        let gap = self
+            .previous
+            .map(|(previous, duration)| (start.duration_since(previous), duration));
+        self.previous = Some((start, chunk));
+        Measurement {
+            start,
+            frames,
+            chunk,
+            gap,
+            queue_delay,
+        }
+    }
+
+    pub fn end(&mut self, measure: Measurement, phases: [Duration; 3]) {
+        self.report.record(
+            measure.frames,
+            measure.chunk,
+            measure.gap,
+            measure.queue_delay,
+            measure.start.elapsed(),
+            phases,
+        );
+        if self.since.elapsed() >= Duration::from_secs(2) {
+            self.publish();
+        }
+    }
+
+    fn publish(&mut self) {
+        // A busy reader or unconsumed report only postpones publication. Never
+        // block the callback or discard an interval to make a timing log.
+        if let Ok(mut slot) = self.slot.try_lock() {
+            if slot.is_none() {
+                self.report.interval_us = micros(self.since.elapsed());
+                *slot = Some(std::mem::take(&mut self.report));
+                self.since = Instant::now();
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn ms(n: u64) -> Duration {
+        Duration::from_millis(n)
+    }
+
+    #[test]
+    fn separates_work_deadlines_zero_delay_and_scheduling_gaps() {
+        let mut r = Report::default();
+        r.record(
+            480,
+            ms(10),
+            None,
+            Some(ms(0)),
+            ms(12),
+            [ms(3), ms(1), ms(7)],
+        );
+        r.record(
+            960,
+            ms(20),
+            Some((ms(15), ms(10))),
+            Some(ms(15)),
+            ms(16),
+            [ms(1), ms(2), ms(12)],
+        );
+        r.record(
+            480,
+            ms(10),
+            Some((ms(20), ms(20))),
+            Some(ms(10)),
+            ms(10),
+            [ms(1), ms(1), ms(7)],
+        );
+        assert_eq!((r.callbacks, r.frames, r.chunk_total_us), (3, 1920, 40000));
+        assert_eq!(r.totals_us, [38000, 5000, 4000, 26000]);
+        assert_eq!(r.maxima_us, [16000, 3000, 2000, 12000]);
+        assert_eq!(
+            (
+                r.zero_queue_delay,
+                r.past_queue_delay,
+                r.gap_gt_previous_chunk
+            ),
+            (1, 1, 1)
+        );
+        assert_eq!((r.gap_max_us, r.queue_delay_min_us), (20000, Some(0)));
+    }
+
+    #[test]
+    fn busy_or_unread_slot_retains_measurements() {
+        let (reporter, mut cb) = Reporter::new(2, 48000);
+        cb.report.callbacks = 7;
+        let slot = reporter.slot.clone();
+        let held = slot.lock().unwrap();
+        cb.publish();
+        assert_eq!(cb.report.callbacks, 7);
+        drop(held);
+        cb.publish();
+        assert_eq!(cb.report.callbacks, 0);
+        cb.report.callbacks = 3;
+        cb.publish();
+        assert_eq!(cb.report.callbacks, 3);
+        assert_eq!(slot.lock().unwrap().take().unwrap().callbacks, 7);
+        cb.publish();
+        assert_eq!(slot.lock().unwrap().take().unwrap().callbacks, 3);
+    }
+}
