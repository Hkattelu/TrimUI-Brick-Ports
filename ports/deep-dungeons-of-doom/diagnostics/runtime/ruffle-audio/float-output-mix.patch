@@ -0,0 +1,69 @@
+//! Convert once after floating-point voice accumulation, avoiding I16 wraparound.
+use std::time::Duration;
+
+pub(super) fn mix(
+    buffer: &mut [i16],
+    scratch: &mut [f32],
+    mut fill: impl FnMut(&mut [f32]) -> [Duration; 3],
+) -> [Duration; 3] {
+    let mut phases = [Duration::ZERO; 3];
+    // Scratch is preallocated as a whole number of output frames.
+    for chunk in buffer.chunks_mut(scratch.len()) {
+        let floats = &mut scratch[..chunk.len()];
+        let elapsed = fill(floats);
+        for (total, part) in phases.iter_mut().zip(elapsed) {
+            *total += part;
+        }
+        for (dest, sample) in chunk.iter_mut().zip(floats.iter()) {
+            // Rust float-to-integer casts saturate; NaN becomes silence.
+            *dest = (*sample * 32768.0) as i16;
+        }
+    }
+    phases
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn overlaps_clip_only_after_all_voices_and_preserve_cancellation() {
+        let loud = 30000.0 / 32768.0;
+        let values = [
+            loud + loud,
+            -loud - loud,
+            loud + loud - loud,
+            -loud - loud + loud,
+            0.0,
+            f32::NAN,
+        ];
+        let mut result = [0_i16; 6];
+        let mut scratch = [0.0; 4];
+        let mut offset = 0;
+        let phases = mix(&mut result, &mut scratch, |part| {
+            part.copy_from_slice(&values[offset..offset + part.len()]);
+            offset += part.len();
+            [Duration::from_micros(1); 3]
+        });
+        assert_eq!(result, [32767, -32768, 30000, -30000, 0, 0]);
+        assert_eq!(phases, [Duration::from_micros(2); 3]);
+    }
+
+    #[test]
+    fn every_i16_value_roundtrips_and_unsigned_equilibrium_is_preserved() {
+        let mut result = vec![0_i16; 65536];
+        let mut scratch = [0.0; 4096];
+        let mut next = i16::MIN as i32;
+        mix(&mut result, &mut scratch, |part| {
+            for value in part {
+                *value = next as f32 / 32768.0;
+                next += 1;
+            }
+            [Duration::ZERO; 3]
+        });
+        for (index, value) in result.iter().enumerate() {
+            assert_eq!(*value as i32, index as i32 - 32768);
+            assert_eq!((*value as u16).wrapping_add(32768), index as u16);
+        }
+    }
+}
