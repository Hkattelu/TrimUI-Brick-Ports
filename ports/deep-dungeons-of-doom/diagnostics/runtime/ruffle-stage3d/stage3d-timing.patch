new file mode 100644
index 0000000..64a1ea4
--- /dev/null
+++ b/render/wgpu/src/context3d/timing.rs
@@ -0,0 +1,103 @@
+use std::time::{Duration, Instant};
+
+#[derive(Clone, Copy)]
+pub(super) enum Phase {
+    Draw,
+    UploadIndex,
+    UploadVertex,
+    Constants,
+    TextureUpload,
+    Configure,
+    Other,
+    Pipeline,
+    Prepare,
+    Encode,
+    Submit,
+    Recall,
+    Present,
+}
+
+#[derive(Clone, Copy, Default, Debug, PartialEq, Eq)]
+pub(super) struct Metric {
+    pub count: u64,
+    pub total: Duration,
+    pub max: Duration,
+}
+
+pub(super) struct Report {
+    pub elapsed: Duration,
+    pub phases: [Metric; 13],
+}
+
+pub(super) struct Stage3dTiming {
+    start: Instant,
+    phases: [Metric; 13],
+}
+
+impl Stage3dTiming {
+    pub fn new(start: Instant) -> Self {
+        Self {
+            start,
+            phases: [Metric::default(); 13],
+        }
+    }
+
+    pub fn record(&mut self, phase: Phase, elapsed: Duration) {
+        let metric = &mut self.phases[phase as usize];
+        metric.count += 1;
+        metric.total += elapsed;
+        metric.max = metric.max.max(elapsed);
+    }
+
+    pub fn take_report(&mut self, now: Instant) -> Option<Report> {
+        let elapsed = now.saturating_duration_since(self.start);
+        if elapsed < Duration::from_secs(2) {
+            return None;
+        }
+        self.start = now;
+        Some(Report {
+            elapsed,
+            phases: std::mem::take(&mut self.phases),
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn window_retains_early_samples_and_resets_after_reporting() {
+        let start = Instant::now();
+        let mut timing = Stage3dTiming::new(start);
+        timing.record(Phase::Draw, Duration::from_millis(15));
+        timing.record(Phase::Draw, Duration::from_millis(5));
+        timing.record(Phase::Submit, Duration::from_millis(12));
+        assert!(timing
+            .take_report(start + Duration::from_millis(1999))
+            .is_none());
+        let report = timing.take_report(start + Duration::from_secs(2)).unwrap();
+        assert_eq!(report.elapsed, Duration::from_secs(2));
+        assert_eq!(
+            report.phases[Phase::Draw as usize],
+            Metric {
+                count: 2,
+                total: Duration::from_millis(20),
+                max: Duration::from_millis(15),
+            }
+        );
+        assert_eq!(
+            report.phases[Phase::Submit as usize].total,
+            Duration::from_millis(12)
+        );
+        assert_eq!(report.phases[Phase::Other as usize], Metric::default());
+        assert!(timing.take_report(start + Duration::from_secs(3)).is_none());
+        assert_eq!(
+            timing
+                .take_report(start + Duration::from_secs(4))
+                .unwrap()
+                .phases,
+            [Metric::default(); 13]
+        );
+    }
+}
