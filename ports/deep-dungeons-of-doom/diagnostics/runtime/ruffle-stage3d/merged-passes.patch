@@ -0,0 +1,91 @@
+//! Draw snapshots for the opt-in Stage3D pass-merging experiment.
+use super::{ClearColor, COLOR_MASK, DEPTH_MASK, STENCIL_MASK};
+
+pub(super) struct Draw {
+    pub pipeline: Option<wgpu::RenderPipeline>,
+    pub bind_group: Option<wgpu::BindGroup>,
+    pub offsets: [u32; 2],
+    pub vertices: Vec<wgpu::Buffer>,
+    pub index: wgpu::Buffer,
+    pub indices: std::ops::Range<u32>,
+    pub stencil: u32,
+    pub scissor: [u32; 4],
+    pub can_draw: bool,
+}
+
+pub(super) struct Pass {
+    pub color: wgpu::TextureView,
+    pub resolve: Option<wgpu::TextureView>,
+    pub depth: Option<wgpu::TextureView>,
+    pub clear: Option<ClearColor>,
+    pub draws: Vec<Draw>,
+}
+
+impl Pass {
+    pub fn encode(self, device: &wgpu::Device) -> wgpu::CommandBuffer {
+        let color_load = match self.clear {
+            Some(c) if c.mask & COLOR_MASK != 0 => wgpu::LoadOp::Clear(c.rgb),
+            _ => wgpu::LoadOp::Load,
+        };
+        let depth_load = match self.clear {
+            Some(c) if c.mask & DEPTH_MASK != 0 => wgpu::LoadOp::Clear(c.depth),
+            _ => wgpu::LoadOp::Load,
+        };
+        let stencil_load = match self.clear {
+            Some(c) if c.mask & STENCIL_MASK != 0 => wgpu::LoadOp::Clear(c.stencil),
+            _ => wgpu::LoadOp::Load,
+        };
+        let depth = self
+            .depth
+            .as_ref()
+            .map(|view| wgpu::RenderPassDepthStencilAttachment {
+                view,
+                depth_ops: Some(wgpu::Operations {
+                    load: depth_load,
+                    store: wgpu::StoreOp::Store,
+                }),
+                stencil_ops: Some(wgpu::Operations {
+                    load: stencil_load,
+                    store: wgpu::StoreOp::Store,
+                }),
+            });
+        let mut encoder = device.create_command_encoder(&wgpu::CommandEncoderDescriptor {
+            label: Some("Merged Stage3D draws"),
+        });
+        {
+            let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                label: Some("Merged Stage3D pass"),
+                color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                    view: &self.color,
+                    resolve_target: self.resolve.as_ref(),
+                    ops: wgpu::Operations {
+                        load: color_load,
+                        store: wgpu::StoreOp::Store,
+                    },
+                    depth_slice: None,
+                })],
+                depth_stencil_attachment: depth,
+                ..Default::default()
+            });
+            for draw in &self.draws {
+                if let Some(pipeline) = &draw.pipeline {
+                    pass.set_pipeline(pipeline);
+                }
+                if let Some(group) = &draw.bind_group {
+                    pass.set_bind_group(0, group, &draw.offsets);
+                }
+                pass.set_stencil_reference(draw.stencil);
+                let [x, y, w, h] = draw.scissor;
+                pass.set_scissor_rect(x, y, w, h);
+                for (index, buffer) in draw.vertices.iter().enumerate() {
+                    pass.set_vertex_buffer(index as u32, buffer.slice(..));
+                }
+                pass.set_index_buffer(draw.index.slice(..), wgpu::IndexFormat::Uint16);
+                if draw.can_draw {
+                    pass.draw_indexed(draw.indices.clone(), 0, 0..1);
+                }
+            }
+        }
+        encoder.finish()
+    }
+}
