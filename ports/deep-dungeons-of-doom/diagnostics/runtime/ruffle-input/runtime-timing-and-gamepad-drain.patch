diff --git a/desktop/src/gamepad_drain.rs b/desktop/src/gamepad_drain.rs
new file mode 100644
index 0000000..8a18437
--- /dev/null
+++ b/desktop/src/gamepad_drain.rs
@@ -0,0 +1,161 @@
+//! Private opt-in experiment. The default still consumes one Gilrs event.
+
+pub(crate) const MAX_EVENTS_PER_POLL: usize = 64;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct PollCounts {
+    pub fetched: usize,
+    pub converted: usize,
+    /// The limit was reached; this does not prove another event is queued.
+    pub limit_reached: bool,
+}
+
+/// Preserve FIFO dispatch, including unhandled converted edges. `dispatch`
+/// reports conversion, not the movie handler's return value. The bound counts
+/// returned Gilrs events, not raw kernel events or time spent inside Gilrs.
+pub(crate) fn poll_events<E>(
+    drain_pending: bool,
+    mut next: impl FnMut() -> Option<E>,
+    mut dispatch: impl FnMut(E) -> bool,
+) -> PollCounts {
+    let limit = if drain_pending {
+        MAX_EVENTS_PER_POLL
+    } else {
+        1
+    };
+    let mut counts = PollCounts::default();
+    for _ in 0..limit {
+        let Some(event) = next() else {
+            return counts;
+        };
+        counts.fetched += 1;
+        if dispatch(event) {
+            counts.converted += 1;
+        }
+    }
+    counts.limit_reached = drain_pending;
+    counts
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::collections::VecDeque;
+
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    enum Event {
+        Down(u8),
+        Up(u8),
+        Ignored,
+    }
+
+    fn poll(queue: &mut VecDeque<Event>, drain: bool) -> (PollCounts, Vec<Event>) {
+        let mut delivered = Vec::new();
+        let counts = poll_events(
+            drain,
+            || queue.pop_front(),
+            |event| {
+                if event == Event::Ignored {
+                    false
+                } else {
+                    delivered.push(event);
+                    true
+                }
+            },
+        );
+        (counts, delivered)
+    }
+
+    #[test]
+    fn default_consumes_exactly_one_even_when_ignored() {
+        let mut queue = VecDeque::from([Event::Ignored, Event::Down(1), Event::Up(1)]);
+        let (counts, delivered) = poll(&mut queue, false);
+        assert_eq!(
+            counts,
+            PollCounts {
+                fetched: 1,
+                converted: 0,
+                limit_reached: false
+            }
+        );
+        assert!(delivered.is_empty());
+        assert_eq!(queue, [Event::Down(1), Event::Up(1)]);
+    }
+
+    #[test]
+    fn drain_delivers_a_complete_short_tap_before_returning() {
+        let mut queue =
+            VecDeque::from([Event::Down(1), Event::Ignored, Event::Up(1), Event::Ignored]);
+        let (counts, delivered) = poll(&mut queue, true);
+        assert_eq!(delivered, [Event::Down(1), Event::Up(1)]);
+        assert_eq!(
+            counts,
+            PollCounts {
+                fetched: 4,
+                converted: 2,
+                limit_reached: false
+            }
+        );
+        assert!(queue.is_empty());
+    }
+
+    #[test]
+    fn held_and_opposite_direction_edges_keep_fifo_order() {
+        let expected = [
+            Event::Down(1),
+            Event::Up(1),
+            Event::Down(2),
+            Event::Up(2),
+            Event::Down(1),
+        ];
+        let mut queue = VecDeque::from(expected);
+        let (_, delivered) = poll(&mut queue, true);
+        assert_eq!(delivered, expected);
+    }
+
+    #[test]
+    fn ignored_or_unhandled_events_do_not_end_drain() {
+        let mut queue = VecDeque::from([0, 1, 2, 3]);
+        let mut visited = Vec::new();
+        let counts = poll_events(
+            true,
+            || queue.pop_front(),
+            |event| {
+                visited.push(event);
+                event % 2 == 1
+            },
+        );
+        assert_eq!(visited, [0, 1, 2, 3]);
+        assert_eq!(counts.fetched, 4);
+        assert_eq!(counts.converted, 2);
+    }
+
+    #[test]
+    fn bound_does_not_fetch_the_sixty_fifth_event() {
+        let mut queue = VecDeque::from(vec![Event::Ignored; MAX_EVENTS_PER_POLL]);
+        queue.push_back(Event::Down(1));
+        let (counts, delivered) = poll(&mut queue, true);
+        assert_eq!(counts.fetched, 64);
+        assert!(counts.limit_reached);
+        assert!(delivered.is_empty());
+        assert_eq!(queue, [Event::Down(1)]);
+    }
+
+    #[test]
+    fn edge_at_limit_is_dispatched_without_fetching_its_release() {
+        let mut queue = VecDeque::from(vec![Event::Ignored; MAX_EVENTS_PER_POLL - 1]);
+        queue.extend([Event::Down(1), Event::Up(1)]);
+        let (counts, delivered) = poll(&mut queue, true);
+        assert_eq!(counts.fetched, 64);
+        assert_eq!(counts.converted, 1);
+        assert!(counts.limit_reached);
+        assert_eq!(delivered, [Event::Down(1)]);
+        assert_eq!(queue, [Event::Up(1)]);
+    }
+
+    #[test]
+    fn empty_queue_never_dispatches() {
+        let mut queue = VecDeque::<Event>::new();
+        assert_eq!(poll(&mut queue, true), (PollCounts::default(), Vec::new()));
+    }
+}
