index 0000000..2c7e39e
--- /dev/null
+++ b/desktop/src/runtime_timing.rs
@@ -0,0 +1,187 @@
+//! Coarse wall-clock diagnostics, allocated only when explicitly enabled.
+//! Durations overlap: poll includes dispatch, and loop includes poll/tick/render.
+//! GUI render includes acquisition/submission/presentation, not GPU completion.
+
+use std::time::{Duration, Instant};
+
+#[derive(Clone, Copy)]
+pub(crate) enum Phase {
+    Poll,
+    Dispatch,
+    Tick,
+    MovieRender,
+    GuiRender,
+    Loop,
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct Metric {
+    pub count: u64,
+    pub total: Duration,
+    pub max: Duration,
+}
+
+impl Metric {
+    fn add(&mut self, duration: Duration) {
+        self.count += 1;
+        self.total += duration;
+        self.max = self.max.max(duration);
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub(crate) struct Report {
+    pub elapsed: Duration,
+    pub phases: [Metric; 6],
+    pub poll_gap: Metric,
+    pub gilrs_events: u64,
+    pub converted_edges: u64,
+    pub limit_reached: u64,
+}
+
+pub(crate) struct RuntimeTiming {
+    report_start: Instant,
+    previous_poll: Option<Instant>,
+    report: Report,
+}
+
+pub(crate) fn enabled_value(value: Option<&str>) -> bool {
+    value == Some("1")
+}
+
+pub(crate) fn enabled(name: &str) -> bool {
+    enabled_value(std::env::var(name).ok().as_deref())
+}
+
+impl RuntimeTiming {
+    pub fn new(now: Instant) -> Self {
+        Self {
+            report_start: now,
+            previous_poll: None,
+            report: Report::default(),
+        }
+    }
+
+    pub fn poll_started(&mut self, now: Instant) {
+        if let Some(previous) = self.previous_poll.replace(now) {
+            self.report
+                .poll_gap
+                .add(now.saturating_duration_since(previous));
+        }
+    }
+
+    pub fn record(&mut self, phase: Phase, duration: Duration) {
+        self.report.phases[phase as usize].add(duration);
+    }
+
+    pub fn events(&mut self, fetched: usize, converted: usize, limit_reached: bool) {
+        self.report.gilrs_events += fetched as u64;
+        self.report.converted_edges += converted as u64;
+        self.report.limit_reached += u64::from(limit_reached);
+    }
+
+    pub fn take_report(&mut self, now: Instant) -> Option<Report> {
+        let elapsed = now.saturating_duration_since(self.report_start);
+        if elapsed < Duration::from_secs(1) {
+            return None;
+        }
+        let mut report = std::mem::take(&mut self.report);
+        report.elapsed = elapsed;
+        self.report_start = now;
+        Some(report)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_exact_one_enables_the_diagnostic() {
+        for value in [
+            None,
+            Some(""),
+            Some("0"),
+            Some("true"),
+            Some(" 1"),
+            Some("1\n"),
+        ] {
+            assert!(!enabled_value(value));
+        }
+        assert!(enabled_value(Some("1")));
+    }
+
+    #[test]
+    fn reports_once_per_second_and_resets_sums_but_retains_poll_boundary() {
+        let start = Instant::now();
+        let mut timing = RuntimeTiming::new(start);
+        timing.poll_started(start);
+        timing.poll_started(start + Duration::from_millis(560));
+        timing.record(Phase::Tick, Duration::from_millis(6));
+        timing.record(Phase::Tick, Duration::from_millis(4));
+        timing.events(4, 2, false);
+        assert!(timing
+            .take_report(start + Duration::from_millis(999))
+            .is_none());
+        let first = timing.take_report(start + Duration::from_secs(1)).unwrap();
+        assert_eq!(
+            first.phases[Phase::Tick as usize],
+            Metric {
+                count: 2,
+                total: Duration::from_millis(10),
+                max: Duration::from_millis(6)
+            }
+        );
+        assert_eq!(first.poll_gap.max, Duration::from_millis(560));
+        assert_eq!(
+            (
+                first.gilrs_events,
+                first.converted_edges,
+                first.limit_reached
+            ),
+            (4, 2, 0)
+        );
+        assert!(timing
+            .take_report(start + Duration::from_millis(1001))
+            .is_none());
+        timing.poll_started(start + Duration::from_millis(1120));
+        let second = timing.take_report(start + Duration::from_secs(2)).unwrap();
+        assert_eq!(second.phases, [Metric::default(); 6]);
+        assert_eq!(
+            second.poll_gap,
+            Metric {
+                count: 1,
+                total: Duration::from_millis(560),
+                max: Duration::from_millis(560)
+            }
+        );
+        assert_eq!(second.gilrs_events, 0);
+    }
+
+    #[test]
+    fn every_phase_is_independent_and_limit_counts_are_retained() {
+        let start = Instant::now();
+        let mut timing = RuntimeTiming::new(start);
+        for (i, phase) in [
+            Phase::Poll,
+            Phase::Dispatch,
+            Phase::Tick,
+            Phase::MovieRender,
+            Phase::GuiRender,
+            Phase::Loop,
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            timing.record(phase, Duration::from_millis(i as u64 + 1));
+        }
+        timing.events(64, 32, true);
+        let report = timing.take_report(start + Duration::from_secs(2)).unwrap();
+        for (i, metric) in report.phases.iter().enumerate() {
+            assert_eq!(metric.count, 1);
+            assert_eq!(metric.total, Duration::from_millis(i as u64 + 1));
+        }
+        assert_eq!(report.limit_reached, 1);
+        assert_eq!(report.elapsed, Duration::from_secs(2));
+    }
+}
