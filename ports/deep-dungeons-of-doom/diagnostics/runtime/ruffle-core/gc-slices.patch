diff --git a/core/src/ddd_gc.rs b/core/src/ddd_gc.rs
new file mode 100644
index 0000000..cb0b831
--- /dev/null
+++ b/core/src/ddd_gc.rs
@@ -0,0 +1,166 @@
+//! Optional incremental cleanup for the constrained DDD runtime.
+//!
+//! The time limit is soft: tracing or dropping one value cannot be interrupted.
+//! Excessive debt falls back to the collector's normal full debt payment.
+use gc_arena::arena::Root;
+use gc_arena::{Arena, Collect, Rootable};
+use std::sync::OnceLock;
+use std::time::Duration;
+use web_time::Instant;
+
+const CHUNK_STEPS: usize = 256;
+const MAX_DEBT: f64 = 65_536.0;
+const SLICE: Duration = Duration::from_millis(3);
+
+pub(crate) fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| {
+        std::env::var_os("RUFFLE_DDD_GC_SLICES").is_some_and(|value| value == "1")
+    })
+}
+
+#[derive(Debug)]
+pub(crate) struct Report {
+    pub debt_before: f64,
+    pub debt_after: f64,
+    pub gc_count: usize,
+    pub chunks: u32,
+    pub pressure_fallback: bool,
+}
+
+fn pay_chunk<R>(arena: &mut Arena<R>)
+where
+    R: for<'a> Rootable<'a>,
+    for<'a> Root<'a, R>: Collect<'a>,
+{
+    arena.collect_debt_steps(CHUNK_STEPS);
+}
+
+pub(crate) fn collect<R>(arena: &mut Arena<R>) -> Report
+where
+    R: for<'a> Rootable<'a>,
+    for<'a> Root<'a, R>: Collect<'a>,
+{
+    let started = Instant::now();
+    let debt_before = arena.metrics().allocation_debt();
+    let pressure_fallback = debt_before > MAX_DEBT;
+    let mut chunks = 0;
+    if pressure_fallback {
+        arena.collect_debt();
+    } else {
+        while arena.metrics().allocation_debt() > 0.0 {
+            pay_chunk(arena);
+            chunks += 1;
+            if started.elapsed() >= SLICE {
+                break;
+            }
+        }
+    }
+    Report {
+        debt_before,
+        debt_after: arena.metrics().allocation_debt(),
+        gc_count: arena.metrics().total_gc_count(),
+        chunks,
+        pressure_fallback,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use gc_arena::arena::CollectionPhase;
+    use gc_arena::{Gc, RefLock};
+    use std::rc::Rc;
+
+    #[derive(Clone)]
+    struct Tracked(Rc<()>);
+    gc_arena::static_collect!(Tracked);
+
+    #[derive(Collect)]
+    #[collect(no_drop)]
+    struct Graph<'gc> {
+        survivors: Gc<'gc, RefLock<Vec<Gc<'gc, Tracked>>>>,
+    }
+
+    #[test]
+    fn sliced_collection_keeps_live_values_and_reclaims_bursts() {
+        let marker = Rc::new(());
+        let mut arena = Arena::<Rootable![Graph<'_>]>::new(|mc| Graph {
+            survivors: Gc::new(mc, RefLock::new(Vec::new())),
+        });
+        let mut max_count = 0;
+        for round in 0..120 {
+            arena.mutate(|mc, root| {
+                let mut values = root.survivors.unlock(mc).borrow_mut();
+                values.clear();
+                for _ in 0..32 {
+                    values.push(Gc::new(mc, Tracked(marker.clone())));
+                }
+                for _ in 0..if round % 12 == 0 { 12_000 } else { 400 } {
+                    Gc::new(mc, Tracked(marker.clone()));
+                }
+            });
+            collect(&mut arena);
+            max_count = max_count.max(arena.metrics().total_gc_count());
+            arena.mutate(|_, root| {
+                let values = root.survivors.borrow();
+                assert_eq!(values.len(), 32);
+                assert!(values.iter().all(|v| Rc::ptr_eq(&v.0, &marker)));
+            });
+        }
+        for _ in 0..1000 {
+            if arena.metrics().allocation_debt() == 0.0 { break; }
+            pay_chunk(&mut arena);
+        }
+        assert_eq!(arena.metrics().allocation_debt(), 0.0);
+        assert!(max_count < 50_000, "transient allocations grew without collection");
+        arena.finish_cycle();
+        assert_eq!(Rc::strong_count(&marker), 33);
+        arena.mutate(|mc, root| root.survivors.unlock(mc).borrow_mut().clear());
+        arena.finish_cycle();
+        assert_eq!(Rc::strong_count(&marker), 1);
+    }
+
+    #[test]
+    fn excessive_debt_uses_normal_collection() {
+        let mut arena = Arena::<Rootable![()]>::new(|_| ());
+        arena.mutate(|mc, _| { for _ in 0..100_000 { Gc::new(mc, 0u8); } });
+        let report = collect(&mut arena);
+        assert!(report.pressure_fallback);
+        assert_eq!(report.debt_after, 0.0);
+        assert_eq!(report.gc_count, 0);
+    }
+
+    #[test]
+    fn reclaiming_an_empty_heap_clears_debt() {
+        let mut arena = Arena::<Rootable![()]>::new(|_| ());
+        arena.mutate(|mc, _| { for _ in 0..20 { Gc::new(mc, 0u8); } });
+        arena.metrics().adjust_debt(1000.0);
+        pay_chunk(&mut arena);
+        assert_eq!(arena.metrics().allocation_debt(), 0.0);
+        assert_eq!(arena.metrics().total_gc_count(), 0);
+    }
+
+    #[test]
+    fn step_budget_yields_with_unfinished_collection() {
+        let mut arena = Arena::<Rootable![()]>::new(|_| ());
+        arena.mutate(|mc, _| { for _ in 0..30_000 { Gc::new(mc, 0u8); } });
+        let debt = arena.metrics().allocation_debt();
+        let count = arena.metrics().total_gc_count();
+        arena.collect_debt_steps(0);
+        assert_eq!(arena.metrics().allocation_debt(), debt);
+        assert_eq!(arena.metrics().total_gc_count(), count);
+        arena.collect_debt_steps(1);
+        assert_eq!(arena.collection_phase(), CollectionPhase::Marking);
+        assert_eq!(arena.metrics().total_gc_count(), count);
+        pay_chunk(&mut arena);
+        assert!(arena.metrics().total_gc_count() >= count - CHUNK_STEPS);
+        assert!(arena.metrics().allocation_debt() > 0.0);
+        for _ in 0..1000 {
+            if arena.metrics().allocation_debt() == 0.0 { break; }
+            pay_chunk(&mut arena);
+        }
+        assert_eq!(arena.metrics().total_gc_count(), 0);
+        assert_eq!(arena.metrics().allocation_debt(), 0.0);
+    }
+}
