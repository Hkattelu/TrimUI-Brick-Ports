+    /// Pay allocation debt for at most `steps` collector state-machine steps.
+    ///
+    /// Retains the usual tracing, sweeping, and debt accounting. A step may trace
+    /// or drop an arbitrarily large value, so this is not a wall-time guarantee.
+    /// Call repeatedly between mutations to keep collection ahead of allocation.
+    #[inline]
+    pub fn collect_debt_steps(&mut self, steps: usize) {
+        unsafe {
+            self.context.do_collection(
+                &self.root,
+                RunUntil::PayDebtOrSteps(steps),
+                Stop::Full,
+            );
+        }
+    }
+
     /// Run only the *marking* part of incremental garbage collection until allocation debt is zero.
     ///
     /// This does *not* transition collection past the [`CollectionPhase::Marked`]
