+//! Opt-in wall-time diagnostics. Durations may overlap and include descheduling.
+use std::sync::OnceLock;
+use web_time::Instant;
+
+pub(crate) fn start() -> Option<Instant> {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    ENABLED
+        .get_or_init(|| std::env::var_os("RUFFLE_DDD_CORE_TIMING").is_some_and(|v| v == "1"))
+        .then(Instant::now)
+}
+
+pub(crate) fn finish(phase: &'static str, started: Option<Instant>) {
+    if let Some(started) = started {
+        let elapsed = started.elapsed();
+        if elapsed.as_micros() >= 8_000 {
+            tracing::info!(target: "ddd_core_timing", phase,
+                elapsed_us = elapsed.as_micros() as u64,
+                "Core slow phase: overlapping wall time, not CPU time");
+        }
+    }
+}
